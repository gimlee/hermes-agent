  "cards": [
    {"dot": "cyan", "title": "精简事实常驻 · 缓存稳定", "items": ["启动读取两份笔记并冻结 system prompt 快照；memory 写入落盘，不修改已缓存前缀。", "新会话读取更新；上下文压缩允许刷新快照。默认上限为 2200 / 1375 字符。"]},
    {"dot": "violet", "title": "外部召回随回合追加", "items": ["默认只启用内置记忆；memory.provider 配置最多一个外部插件。", "召回放入当前用户消息的 API 副本；api_content 保留发送字节，后续回合原样重放。", "仅完整回合同步；会话边界按 end → switch 顺序执行。"]},
    {"dot": "emerald", "title": "历史与经验各有归宿", "items": ["session_search 按需查历史消息，不调用 LLM；压缩归档仍可检索。", "后台复盘不写入用户会话；无人工参与的 replace/remove 会进入待审批记录。", "跨任务事实进入长期笔记；任务流程、偏好与纠错进入对应 Skills。"]},
    {"dot": "slate", "title": "阅读约定与实现边界", "items": ["箭头表示调用或 I/O 请求；返回内容沿调用路径回到 Agent。虚线表示可选插件路径。", "内置笔记按 profile home 共享，不等于按聊天参与者隔离；外部身份映射由插件实现。", "组件来源固定到 eb7e862；存储后端、抽取与一致性保证随 provider 实现变化。"]}
  ]
